---
import Base from '../layouts/Base.astro';
import { boutique, horaires, hero, bonjourWoman, collections, avis, magazine } from '../data/site';
// Codes inspirés de liujo.com : blanc, noir, capitales grasses, photos bord à bord
const [pap, jeans, maro, chaussures, couture, accessoires] = collections;
const duo = [pap, maro];
const quatre = [jeans, chaussures, couture, accessoires];
const portraits = [magazine.noirEtBlanc, bonjourWoman[1], bonjourWoman[2], bonjourWoman[3], bonjourWoman[4]];
---
<Base>
  <!-- OUVERTURE -->
  <section class="ouverture">
    <img src={hero.photo} alt={hero.alt} width="1600" height="1100" fetchpriority="high" />
    <div class="ouverture__texte">
      <h1>Chez Woman,<br />on prend le temps</h1>
      <p>Boutique 100 % Liu&nbsp;Jo · Belfort</p>
      <div class="actions">
        <a class="filet filet--blanc" href="#venir">Venir en boutique</a>
        <a class="filet filet--blanc" href={boutique.instagram} target="_blank" rel="noopener">Voir les nouveautés</a>
      </div>
    </div>
  </section>

  <!-- DEUX COLLECTIONS BORD À BORD -->
  <section id="vestiaire" aria-label="Collections">
    <ul class="duo">
      {duo.map((c) => (
        <li class="tuile tuile--grande">
          <img src={c.photo} alt={c.alt} loading="lazy" width="900" height="1100" />
          <div class="tuile__legende">
            <h2>{c.nom}</h2>
            <a class="filet filet--blanc" href={boutique.instagram} target="_blank" rel="noopener">Découvrir</a>
          </div>
        </li>
      ))}
    </ul>
    <ul class="quatre">
      {quatre.map((c) => (
        <li class="tuile">
          <img src={c.photo} alt={c.alt} loading="lazy" width="600" height="800" />
          <div class="tuile__legende"><h2>{c.nom}</h2></div>
        </li>
      ))}
    </ul>
  </section>

  <!-- ELLES PORTENT WOMAN -->
  <section id="bonjour" class="portraits">
    <div class="ligne-titre">
      <h2>Elles portent Woman</h2>
      <p>Pas de mannequins : des femmes de Belfort, de tous les âges et de toutes les morphologies. Chaque matin, l'une d'elles vous dit bonjour sur Instagram.</p>
    </div>
    <ul class="cinq">
      {portraits.map((p) => (
        <li class="tuile">
          <img src={p.src} alt={p.alt} loading="lazy" width="600" height="900" />
          <div class="tuile__legende tuile__legende--petite">Bonjour Woman</div>
        </li>
      ))}
    </ul>
  </section>

  <!-- 8 SECONDES -->
  <section class="bandeau-texte">
    <p class="sur">Chaque mardi sur Instagram</p>
    <h2>8 secondes chez Woman</h2>
    <p>Une pièce, une idée, huit secondes. Et la question qu'on adore vous poser : « Je vous la garde&nbsp;? »</p>
    <a class="filet" href={boutique.instagram} target="_blank" rel="noopener">Suivre @woman.belfort</a>
  </section>

  <!-- LA BOUTIQUE -->
  <section id="histoire" class="boutique">
    <div class="boutique__photo">
      <img src={magazine.vitrine.src} alt={magazine.vitrine.alt} loading="lazy" width="900" height="1100" />
    </div>
    <div class="boutique__texte">
      <p class="sur">La boutique</p>
      <h2>Au Faubourg des Ancêtres depuis 2007</h2>
      <p>
        En 2007, Woman ouvre ses portes au Faubourg des Ancêtres. En octobre 2024, Natacha reprend la boutique
        et la consacre entièrement à Liu&nbsp;Jo.
      </p>
      <p>
        Un dressing immense dans lequel puiser la ou les pièces qui vous permettront de vous sentir toujours plus belle.
        Chez Woman, on prend le temps, on partage et on se fait plaisir.
      </p>
      <blockquote>« On aime vous habiller, partager le café ou l'apéro, papoter et échanger avec vous toutes. »<cite>Natacha</cite></blockquote>
    </div>
  </section>

  <!-- AVIS -->
  <section class="avis">
    <div class="ligne-titre">
      <h2>Elles en parlent</h2>
      <a class="filet" href={boutique.avisGoogle} target="_blank" rel="noopener">Laisser un avis Google</a>
    </div>
    <div class="avis__grille">
      {avis.map((a) => (
        <figure>
          <blockquote>{a.texte}</blockquote>
          <figcaption>{a.auteur}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- INFOS PRATIQUES -->
  <section id="venir" class="infos">
    <div class="infos__bloc">
      <h2>Venir en boutique</h2>
      <address>{boutique.adresse}<br />{boutique.ville}</address>
      <a class="filet" href={boutique.itineraire} target="_blank" rel="noopener">Itinéraire</a>
    </div>
    <div class="infos__bloc">
      <h2>Horaires</h2>
      <dl>
        {horaires.map((h) => (<><dt>{h.jour}</dt><dd>{h.heures}</dd></>))}
      </dl>
      <p class="infos__natacha">Et les horaires de Natacha, bien plus étendus : le midi, le soir, le lundi matin, sur rendez-vous.</p>
    </div>
    <div class="infos__bloc">
      <h2>Nous contacter</h2>
      <p><a href={boutique.telephoneLien}>{boutique.telephone}</a><br /><a href={`mailto:${boutique.email}`}>{boutique.email}</a></p>
      <a class="filet filet--plein" href={boutique.telephoneLien}>Appeler la boutique</a>
    </div>
  </section>
</Base>

<style>
  h2 { font-family: var(--titre); font-weight: 700; text-transform: uppercase; letter-spacing: 0.01em; line-height: 1.05; }

  /* Boutons en simple filet */
  .filet {
    display: inline-block; padding: 0.55rem 1.6rem; border: 1px solid var(--encre); color: var(--encre);
    font-family: var(--titre); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .filet:hover { background: var(--encre); color: #fff; }
  .filet--blanc { border-color: #fff; color: #fff; }
  .filet--blanc:hover { background: #fff; color: var(--encre); }
  .filet--plein { background: var(--encre); color: #fff; }
  .filet--plein:hover { background: #fff; color: var(--encre); }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.6rem; margin-top: 1.6rem; }

  /* OUVERTURE */
  .ouverture { position: relative; height: min(calc(100svh - 110px), 860px); min-height: 480px; overflow: hidden; color: #fff; }
  .ouverture img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .ouverture::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 35%, rgb(0 0 0 / 0.45)); }
  .ouverture__texte { position: absolute; inset: auto 1rem clamp(2.5rem, 7vh, 5rem); z-index: 1; text-align: center; }
  .ouverture h1 {
    font-family: var(--titre); font-weight: 700; text-transform: uppercase; letter-spacing: 0.005em;
    font-size: clamp(2.2rem, 5.6vw, 4.8rem); line-height: 1; text-shadow: 0 2px 24px rgb(0 0 0 / 0.25);
  }
  .ouverture__texte > p { margin: 0.6rem 0 0; font-family: var(--titre); font-size: 0.85rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; }

  /* TUILES PHOTO */
  .duo, .quatre, .cinq { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .duo { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 4px; }
  .quatre { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 4px; }
  .cinq { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .tuile { position: relative; overflow: hidden; aspect-ratio: 3 / 4; }
  .tuile--grande { aspect-ratio: 4 / 5; }
  .cinq .tuile { aspect-ratio: 2 / 3; }
  .tuile img { width: 100%; height: 100%; object-fit: cover; object-position: center 25%; transition: transform 1s ease; }
  .tuile:hover img { transform: scale(1.03); }
  .tuile::after { content: ''; position: absolute; inset: 50% 0 0; background: linear-gradient(180deg, transparent, rgb(0 0 0 / 0.4)); pointer-events: none; }
  .tuile__legende { position: absolute; left: clamp(0.8rem, 2vw, 1.6rem); bottom: clamp(0.8rem, 2vw, 1.6rem); z-index: 1; color: #fff; }
  .tuile__legende h2 { font-size: clamp(1.1rem, 2vw, 1.9rem); margin-bottom: 0.9rem; }
  .quatre .tuile__legende h2 { font-size: clamp(0.95rem, 1.4vw, 1.25rem); margin: 0; }
  .tuile__legende--petite { font-family: var(--titre); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }

  /* LIGNE DE TITRE */
  .ligne-titre {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem 3rem;
    padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 3vw, 2.5rem) 1.2rem;
  }
  .ligne-titre h2 { font-size: clamp(1.6rem, 3vw, 2.6rem); }
  .ligne-titre p { margin: 0; max-width: 36rem; color: var(--gris); }

  /* 8 SECONDES */
  .bandeau-texte { text-align: center; padding: clamp(4.5rem, 10vw, 8rem) 1.25rem; border-bottom: 1px solid #e6e1df; }
  .sur { margin: 0 0 0.8rem; font-family: var(--titre); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gris); }
  .bandeau-texte h2 { font-size: clamp(2.4rem, 7vw, 6rem); line-height: 0.95; }
  .bandeau-texte > p:not(.sur) { max-width: 34rem; margin: 1.4rem auto 2rem; font-size: 1.1rem; }

  /* LA BOUTIQUE */
  .boutique { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; }
  .boutique__photo { aspect-ratio: 4 / 5; overflow: hidden; }
  .boutique__photo img { width: 100%; height: 100%; object-fit: cover; }
  .boutique__texte { padding: clamp(2.5rem, 6vw, 6rem); max-width: 40rem; }
  .boutique__texte h2 { font-size: clamp(1.8rem, 3.4vw, 3rem); margin-bottom: 1.6rem; }
  .boutique__texte p:not(.sur) { font-size: 1.08rem; line-height: 1.7; }
  .boutique blockquote { margin: 2rem 0 0; padding-left: 1.2rem; border-left: 2px solid var(--encre); font-family: var(--serif); font-style: italic; font-size: 1.45rem; line-height: 1.3; }
  .boutique cite { display: block; margin-top: 0.7rem; font-family: var(--titre); font-style: normal; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; }

  /* AVIS */
  .avis { background: #f6f4f2; padding-bottom: clamp(3rem, 6vw, 5rem); }
  .avis__grille { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2.5rem; padding: 1.6rem clamp(1rem, 3vw, 2.5rem) 0; }
  .avis figure { margin: 0; }
  .avis blockquote { margin: 0; font-size: 1rem; line-height: 1.6; }
  .avis figcaption { margin-top: 0.9rem; font-family: var(--titre); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }

  /* INFOS PRATIQUES */
  .infos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: var(--max); margin: 0 auto; padding: clamp(3.5rem, 7vw, 6rem) 1.25rem; }
  .infos__bloc { padding: 0 clamp(1rem, 3vw, 2.5rem); border-left: 1px solid #ddd6d3; }
  .infos__bloc:first-child { border-left: 0; }
  .infos h2 { font-size: 1rem; letter-spacing: 0.04em; margin-bottom: 1.2rem; }
  .infos address, .infos p { font-style: normal; margin: 0 0 1.4rem; }
  .infos dl { display: grid; grid-template-columns: auto 1fr; gap: 0.4rem 1.2rem; margin: 0 0 1rem; }
  .infos dt { font-weight: 500; }
  .infos dd { margin: 0; }
  .infos__natacha { font-family: var(--serif); font-style: italic; font-size: 1.1rem; }
  .infos a:not(.filet) { text-decoration: none; }
  .infos a:not(.filet):hover { text-decoration: underline; }

  @media (max-width: 900px) {
    .quatre { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cinq { grid-template-columns: repeat(5, 62vw); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .cinq .tuile { scroll-snap-align: start; }
    .avis__grille { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .duo, .boutique, .infos { grid-template-columns: minmax(0, 1fr); }
    .infos__bloc { border-left: 0; border-top: 1px solid #ddd6d3; padding: 2rem 0 0; margin-top: 2rem; }
    .infos__bloc:first-child { border-top: 0; margin-top: 0; padding-top: 0; }
    .avis__grille { grid-template-columns: minmax(0, 1fr); }
    .actions { gap: 0.8rem; }
  }
</style>
