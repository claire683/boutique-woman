---
import Base from '../layouts/Base.astro';
import { boutique, horaires, hero, bonjourWoman, collections, avis, img } from '../data/site';
const bandeau = ['Nouveautés toutes les semaines', '100 % Liu Jo', 'Jeans', 'Sport', 'Prêt-à-porter', 'Couture', 'Chaussures', 'Maroquinerie', 'Faubourg des Ancêtres'];
const collage = [
  { src: hero.photo, alt: hero.alt },
  bonjourWoman[0],
  bonjourWoman[4],
];
---
<Base>
  <!-- OUVERTURE -->
  <section class="ouverture">
    <div class="wrap ouverture__grille">
      <div class="ouverture__texte">
        <p class="kicker kicker--clair">Boutique 100 % Liu Jo · Faubourg des Ancêtres · Belfort</p>
        <h1>Chez Woman, <em>on prend le temps.</em></h1>
        <p class="ouverture__chapo">
          Les collections de la marque italienne, choisies chaque saison par Natacha.
          On essaie, on papote, on se fait plaisir.
        </p>
        <div class="ouverture__actions">
          <a class="btn btn--fuchsia" href="#venir">Venir en boutique</a>
          <a class="btn btn--contour" href={boutique.instagram} target="_blank" rel="noopener">@woman.belfort</a>
        </div>
      </div>
      <div class="collage">
        {collage.map((p, i) => (
          <figure class={`tirage tirage--${i}`}>
            <img src={p.src} alt={p.alt} width="600" height="750" fetchpriority={i === 0 ? 'high' : 'auto'} />
          </figure>
        ))}
        <p class="pastille" aria-hidden="true"><span>Nouveautés<br />toutes les<br />semaines</span></p>
      </div>
    </div>
  </section>

  <!-- BANDEAU -->
  <div class="bandeau" aria-hidden="true">
    <div class="bandeau__piste">
      {[0, 1].map(() => bandeau.map((m) => <span>{m}<i>✦</i></span>))}
    </div>
  </div>
  <p class="sr-only">Nouveautés toutes les semaines. Collections Liu Jo jeans, sport, prêt-à-porter, couture, chaussures et maroquinerie.</p>

  <!-- QUESTION -->
  <section class="question">
    <div class="wrap">
      <p class="question__titre revele">« Chez Woman, on&nbsp;trouve quoi&nbsp;? »</p>
      <ul class="question__reponses revele">
        <li>Tout l'univers Liu&nbsp;Jo, du jean à la robe du soir</li>
        <li>Des nouveautés chaque semaine</li>
        <li>Le temps de bien vous conseiller</li>
        <li>Et un café, si vous restez un peu</li>
      </ul>
    </div>
  </section>

  <!-- BONJOUR WOMAN -->
  <section id="bonjour" class="bonjour">
    <div class="wrap bonjour__tete">
      <div>
        <p class="kicker">Elles portent Woman</p>
        <h2>Bonjour <em>Woman&nbsp;!</em></h2>
      </div>
      <div>
        <p>
          Pas de mannequins : des femmes de Belfort, de tous les âges et de toutes les morphologies,
          qui posent en Liu&nbsp;Jo dans nos rues. Chaque matin, l'une d'elles vous dit bonjour
          sur notre Instagram.
        </p>
        <div class="bonjour__nav">
          <button type="button" data-sens="-1" aria-label="Photos précédentes">←</button>
          <button type="button" data-sens="1" aria-label="Photos suivantes">→</button>
        </div>
      </div>
    </div>
    <div class="bonjour__galerie" tabindex="0" aria-label="Galerie Bonjour Woman">
      {bonjourWoman.map((p, i) => (
        <figure class={`bonjour__item bonjour__item--${i % 4}`}>
          <img src={p.src} alt={p.alt} loading="lazy" width="600" height="800" />
        </figure>
      ))}
    </div>
  </section>

  <!-- COLLECTIONS -->
  <section id="collections" class="collections">
    <div class="wrap">
      <div class="collections__tete">
        <p class="kicker kicker--clair">Les collections</p>
        <h2>Du jean <em>à la robe du soir.</em></h2>
      </div>
      <ul class="collections__grille">
        {collections.map((c) => (
          <li class="collection revele">
            <img src={c.photo} alt={c.alt} loading="lazy" width="500" height="650" />
            <h3>{c.nom}</h3>
          </li>
        ))}
      </ul>
      <p class="collections__note">
        Les arrivages n'ont pas de jour fixe : les nouveautés passent d'abord par
        <a href={boutique.instagram} target="_blank" rel="noopener">Instagram</a>.
        Une pièce vous plaît&nbsp;? Écrivez-nous, on vous la garde.
      </p>
    </div>
  </section>

  <!-- 8 SECONDES -->
  <section class="huit">
    <div class="wrap huit__grille">
      <p class="huit__chiffre" aria-hidden="true">8</p>
      <div>
        <p class="kicker kicker--clair">Chaque mardi sur Instagram</p>
        <h2>secondes<br />chez Woman</h2>
        <p class="huit__texte">Une pièce, une idée, huit secondes. Et la question qu'on adore vous poser&nbsp;:</p>
        <p class="huit__citation">« Je vous la garde&nbsp;? »</p>
        <a class="btn btn--bordeaux" href={boutique.instagram} target="_blank" rel="noopener">Suivre @woman.belfort</a>
      </div>
    </div>
  </section>

  <!-- HISTOIRE -->
  <section id="histoire" class="histoire">
    <div class="wrap histoire__grille">
      <figure class="tirage tirage--histoire revele">
        <img src={img('2015/01/woman-14.jpg')} alt="La vitrine de la boutique Woman, Faubourg des Ancêtres" loading="lazy" width="700" height="900" />
      </figure>
      <div>
        <p class="kicker">La boutique</p>
        <h2>Un lieu de rendez&#8209;vous <em>depuis 2007</em></h2>
        <ol class="frise">
          <li><strong>2007</strong> Woman ouvre ses portes au Faubourg des Ancêtres.</li>
          <li><strong>Octobre 2024</strong> Natacha reprend la boutique et la consacre entièrement à Liu&nbsp;Jo.</li>
          <li><strong>Aujourd'hui</strong> Un dressing immense, des nouveautés chaque semaine, et le temps de bien vous conseiller.</li>
        </ol>
        <blockquote>
          « On aime vous habiller, partager le café ou l'apéro, papoter et échanger avec vous toutes. »
          <cite>Natacha</cite>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- AVIS -->
  <section class="avis">
    <div class="wrap">
      <div class="avis__tete">
        <p class="kicker kicker--clair">Elles en parlent</p>
        <a class="btn btn--contour" href={boutique.avisGoogle} target="_blank" rel="noopener">Laisser un avis sur Google</a>
      </div>
      <div class="avis__grille">
        {avis.map((a) => (
          <figure class="avis__carte revele">
            <blockquote>{a.texte}</blockquote>
            <figcaption>{a.auteur}, avis Google</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- VENIR -->
  <section id="venir" class="venir">
    <div class="wrap venir__grille">
      <div>
        <p class="kicker">Venir en boutique</p>
        <h2>On vous attend au <em>36</em></h2>
        <address>{boutique.adresse}<br />{boutique.ville}</address>
        <div class="venir__actions">
          <a class="btn btn--fuchsia" href={boutique.itineraire} target="_blank" rel="noopener">Itinéraire</a>
          <a class="btn btn--sombre" href={boutique.telephoneLien}>{boutique.telephone}</a>
        </div>
      </div>
      <div class="venir__horaires">
        <h3>Horaires</h3>
        <dl>
          {horaires.map((h) => (<><dt>{h.jour}</dt><dd>{h.heures}</dd></>))}
        </dl>
        <p class="venir__natacha">
          <span>Et il y a les horaires de Natacha, bien plus étendus&nbsp;!</span>
          Le midi, le soir, le lundi matin&nbsp;: appelez la boutique pour caler votre rendez-vous.
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  // Galerie : flèches
  const galerie = document.querySelector<HTMLElement>('.bonjour__galerie');
  document.querySelectorAll<HTMLButtonElement>('.bonjour__nav button').forEach((b) =>
    b.addEventListener('click', () => galerie?.scrollBy({ left: Number(b.dataset.sens) * galerie.clientWidth * 0.8, behavior: 'smooth' }))
  );
  // Apparition au défilement (désactivée si l'utilisatrice limite les animations)
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('anime');
    const io = new IntersectionObserver((entrees) => {
      entrees.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('vu'); io.unobserve(e.target); } });
    }, { threshold: 0.15 });
    document.querySelectorAll('.revele').forEach((el) => io.observe(el));
  }
</script>

<style>
  /* Apparition */
  :global(.anime) .revele { opacity: 0; transform: translateY(28px); transition: opacity 0.7s ease, transform 0.7s ease; }
  :global(.anime) .revele.vu { opacity: 1; transform: none; }

  /* Tirages photo (bord blanc, légère inclinaison) */
  .tirage { margin: 0; background: #fff; padding: 10px 10px 34px; box-shadow: 0 18px 40px rgb(0 0 0 / 0.28); transition: transform 0.4s ease; }
  .tirage img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .tirage:hover { transform: rotate(0deg) scale(1.02); z-index: 5; }

  /* OUVERTURE */
  .ouverture { background: var(--bordeaux); color: var(--creme); overflow: hidden; }
  .ouverture__grille {
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: 3rem; align-items: center;
    padding-block: clamp(3rem, 6vw, 5.5rem) clamp(4rem, 7vw, 6.5rem);
  }
  .ouverture h1 { font-size: clamp(3.2rem, 7.4vw, 6.6rem); line-height: 0.95; margin: 1.2rem 0 1.6rem; color: var(--creme); }
  .ouverture h1 em { display: block; color: var(--fuchsia-vif); }
  .ouverture__chapo { max-width: 31rem; font-size: 1.2rem; margin: 0 0 2.2rem; color: var(--rose); }
  .ouverture__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  .collage { position: relative; height: clamp(420px, 44vw, 600px); }
  .collage .tirage { position: absolute; width: 58%; }
  .tirage--0 { left: 4%; top: 6%; rotate: -5deg; z-index: 2; }
  .tirage--1 { right: 0; top: 0; width: 46% !important; rotate: 6deg; z-index: 1; }
  .tirage--2 { right: 8%; bottom: 0; width: 44% !important; rotate: -2deg; z-index: 3; }
  .pastille {
    position: absolute; left: -1%; bottom: 4%; z-index: 4; margin: 0;
    width: 132px; height: 132px; border-radius: 50%; display: grid; place-items: center; text-align: center;
    background: var(--rose-vif); color: var(--bordeaux);
    font-family: var(--serif); font-style: italic; font-size: 1.05rem; line-height: 1.15;
    rotate: -12deg; box-shadow: 0 10px 24px rgb(0 0 0 / 0.25);
  }

  /* BANDEAU */
  .bandeau {
    background: var(--fuchsia); color: #fff; overflow: hidden; padding: 1.1rem 0;
    rotate: -1.6deg; margin: -1.6rem -2rem 0; position: relative; z-index: 6;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.15);
  }
  .bandeau__piste { display: flex; width: max-content; animation: defile 38s linear infinite; }
  .bandeau span { font-family: var(--serif); font-style: italic; font-size: clamp(1.4rem, 2.6vw, 2.1rem); white-space: nowrap; }
  .bandeau i { font-style: normal; margin: 0 1.6rem; color: var(--rose); }
  @keyframes defile { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .bandeau__piste { animation: none; } }

  /* QUESTION */
  .question { padding: clamp(5rem, 10vw, 8.5rem) 0 clamp(3rem, 6vw, 5rem); text-align: center; }
  .question__titre {
    margin: 0 auto; max-width: 15ch; font-family: var(--serif); font-style: italic;
    font-size: clamp(3rem, 8vw, 7rem); line-height: 0.98; color: var(--fuchsia); text-wrap: balance;
  }
  .question__reponses {
    list-style: none; padding: 0; margin: 2.6rem auto 0; max-width: 60rem;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0.7rem;
  }
  .question__reponses li {
    padding: 0.6rem 1.3rem; border-radius: 999px; background: var(--rose); color: var(--bordeaux); font-weight: 500;
  }

  /* BONJOUR */
  .bonjour { padding: clamp(3rem, 6vw, 5rem) 0 clamp(5rem, 9vw, 8rem); }
  .bonjour__tete { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: end; margin-bottom: 2.5rem; }
  .bonjour h2 { font-size: clamp(3.2rem, 8vw, 7rem); line-height: 0.95; margin-top: 0.6rem; }
  .bonjour h2 em { color: var(--fuchsia); }
  .bonjour__tete p { margin: 0; max-width: 34rem; font-size: 1.1rem; }
  .bonjour__nav { display: flex; gap: 0.5rem; margin-top: 1.4rem; }
  .bonjour__nav button {
    width: 52px; height: 52px; border-radius: 50%; border: 0; background: var(--fuchsia); color: #fff;
    font-size: 1.2rem; cursor: pointer; transition: background 0.2s, transform 0.2s;
  }
  .bonjour__nav button:hover { background: var(--bordeaux); transform: scale(1.08); }
  .bonjour__galerie {
    --bord: max(1.25rem, calc((100vw - var(--max)) / 2));
    display: grid; grid-auto-flow: column; grid-auto-columns: clamp(230px, 24vw, 330px);
    gap: 1.6rem; overflow-x: auto; padding: 1.5rem var(--bord) 2.5rem; scroll-padding-inline: var(--bord);
    scroll-snap-type: x mandatory; scrollbar-width: none;
  }
  .bonjour__galerie::-webkit-scrollbar { display: none; }
  .bonjour__item {
    margin: 0; scroll-snap-align: start; background: #fff; padding: 10px 10px 30px;
    box-shadow: 0 14px 30px rgb(60 10 25 / 0.18); transition: rotate 0.3s, translate 0.3s;
  }
  .bonjour__item img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
  .bonjour__item--0 { rotate: -2.5deg; }
  .bonjour__item--1 { rotate: 2deg; translate: 0 1.2rem; }
  .bonjour__item--2 { rotate: -1deg; }
  .bonjour__item--3 { rotate: 3deg; translate: 0 0.6rem; }
  .bonjour__item:hover { rotate: 0deg; translate: 0 -0.4rem; }

  /* COLLECTIONS */
  .collections { background: var(--encre); color: var(--creme); padding: clamp(4.5rem, 9vw, 8rem) 0; }
  .collections__tete { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 3rem; }
  .collections h2 { font-size: clamp(2.8rem, 6.4vw, 5.6rem); line-height: 0.95; margin-top: 0.6rem; }
  .collections h2 em { color: var(--fuchsia-vif); }
  .collections__grille {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem;
  }
  .collection { position: relative; overflow: hidden; }
  .collection img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform 0.7s ease, filter 0.4s; }
  .collection:hover img { transform: scale(1.07); filter: saturate(1.15); }
  .collection h3 {
    position: absolute; left: 1rem; bottom: 1rem; padding: 0.35rem 1.1rem 0.45rem; border-radius: 999px;
    background: var(--fuchsia); color: #fff; font-size: 1.45rem; font-style: italic;
    transition: background 0.3s;
  }
  .collection:hover h3 { background: var(--rose-vif); color: var(--bordeaux); }
  .collections__note { margin: 2.6rem 0 0; max-width: 42rem; font-size: 1.15rem; color: var(--rose); }
  .collections__note a { color: var(--fuchsia-vif); font-weight: 500; }

  /* 8 SECONDES */
  .huit { background: var(--fuchsia); color: #fff; padding: clamp(4rem, 8vw, 6.5rem) 0; overflow: hidden; }
  .huit__grille { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: center; }
  .huit .huit__chiffre {
    font-family: var(--serif); font-style: italic; font-size: clamp(14rem, 32vw, 28rem);
    line-height: 0.75; margin: 0; color: var(--rose-vif); text-shadow: 10px 10px 0 var(--bordeaux);
  }
  .huit h2 { font-size: clamp(3rem, 7vw, 6rem); line-height: 0.92; margin: 0.6rem 0 1.4rem; color: #fff; }
  .huit__texte { max-width: 30rem; font-size: 1.2rem; margin: 0; }
  .huit__citation { font-family: var(--serif); font-style: italic; font-size: clamp(2rem, 4vw, 3.2rem); margin: 0.3rem 0 1.8rem; color: var(--bordeaux); }

  /* HISTOIRE */
  .histoire { background: var(--rose); padding: clamp(5rem, 9vw, 8rem) 0; }
  .histoire__grille { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: center; }
  .tirage--histoire { rotate: -3deg; }
  .histoire h2 { font-size: clamp(2.6rem, 5.4vw, 4.6rem); line-height: 0.98; margin: 0.6rem 0 2rem; text-wrap: balance; }
  .histoire h2 em { color: var(--fuchsia); }
  .frise { list-style: none; margin: 0 0 2.5rem; padding: 0; border-left: 2px solid var(--fuchsia); }
  .frise li { padding: 0 0 1.2rem 1.6rem; position: relative; }
  .frise li::before {
    content: ''; position: absolute; left: -8px; top: 0.5em; width: 14px; height: 14px;
    background: var(--fuchsia); border-radius: 50%; box-shadow: 0 0 0 4px var(--rose);
  }
  .frise strong { display: block; font-family: var(--serif); font-size: 1.6rem; font-weight: 400; color: var(--bordeaux); }
  .histoire blockquote {
    margin: 0; padding: 1.6rem 1.8rem; background: var(--bordeaux); color: var(--creme);
    font-family: var(--serif); font-style: italic; font-size: clamp(1.4rem, 2.4vw, 1.9rem); line-height: 1.25; rotate: 1deg;
  }
  .histoire cite { display: block; margin-top: 0.8rem; font-family: var(--sans); font-style: normal; font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--rose-vif); }

  /* AVIS */
  .avis { background: var(--bordeaux); padding: clamp(4.5rem, 8vw, 7rem) 0; }
  .avis__tete { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 2.5rem; }
  .avis__grille { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.4rem; align-items: start; }
  .avis__carte { margin: 0; background: var(--creme); padding: 2.6rem 1.5rem 1.5rem; position: relative; box-shadow: 0 14px 30px rgb(0 0 0 / 0.25); }
  .avis__carte:nth-child(odd) { rotate: -1.5deg; }
  .avis__carte:nth-child(even) { rotate: 1.5deg; margin-top: 1.5rem; }
  .avis__carte::before {
    content: '«'; position: absolute; top: -0.35em; left: 1rem; font-family: var(--serif); font-size: 5rem; line-height: 1; color: var(--fuchsia);
  }
  .avis blockquote { margin: 0; font-family: var(--serif); font-size: 1.22rem; line-height: 1.35; }
  .avis figcaption { margin-top: 1rem; font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fuchsia); font-weight: 500; }

  /* VENIR */
  .venir { padding: clamp(5rem, 9vw, 8rem) 0; }
  .venir__grille { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .venir h2 { font-size: clamp(2.8rem, 6vw, 5rem); line-height: 0.95; margin: 0.6rem 0 1.6rem; }
  .venir h2 em { display: inline-block; font-size: 2.1em; line-height: 0.8; color: var(--fuchsia); vertical-align: -0.12em; }
  .venir address { font-style: normal; font-size: 1.35rem; margin-bottom: 2rem; }
  .venir__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .venir__horaires { background: var(--bordeaux); color: var(--creme); padding: clamp(1.8rem, 4vw, 3rem); rotate: 1.2deg; box-shadow: 0 18px 40px rgb(60 10 25 / 0.25); }
  .venir__horaires h3 { font-size: 2.2rem; margin-bottom: 1.2rem; color: var(--rose-vif); }
  .venir dl { display: grid; grid-template-columns: auto 1fr; gap: 0.7rem 1.5rem; margin: 0 0 1.8rem; }
  .venir dt { font-weight: 500; }
  .venir dd { margin: 0; }
  .venir__natacha { margin: 0; border-top: 1px solid color-mix(in srgb, var(--rose) 30%, transparent); padding-top: 1.4rem; color: var(--rose); }
  .venir__natacha span { display: block; font-family: var(--serif); font-style: italic; font-size: 1.45rem; color: var(--fuchsia-vif); margin-bottom: 0.4rem; }

  @media (max-width: 960px) {
    .avis__grille { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    .ouverture__grille, .bonjour__tete, .histoire__grille, .venir__grille { grid-template-columns: minmax(0, 1fr); }
    .collage { height: 440px; max-width: 460px; width: 100%; margin-inline: auto; }
    .pastille { width: 108px; height: 108px; font-size: 0.9rem; }
    .collections__grille { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .huit__grille { grid-template-columns: minmax(0, 1fr); }
    .huit .huit__chiffre { font-size: 11rem; }
    .venir__horaires, .histoire blockquote { rotate: 0deg; }
  }
  @media (max-width: 560px) {
    .collage { height: 360px; }
    .avis__grille { grid-template-columns: minmax(0, 1fr); }
    .avis__carte:nth-child(even) { margin-top: 0; }
    .collection h3 { font-size: 1.15rem; left: 0.6rem; bottom: 0.6rem; }
  }
</style>
