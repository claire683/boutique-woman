---
interface Props { clair?: boolean }
const { clair = false } = Astro.props;
---
<span class:list={['logo', { 'logo--clair': clair }]} aria-label="Woman, boutique Liu Jo Belfort">
  <span class="logo__nom" aria-hidden="true">woman</span>
  <span class="logo__sous" aria-hidden="true">Liu Jo · Belfort</span>
</span>

<style>
  .logo { display: inline-flex; flex-direction: column; align-items: center; line-height: 1; color: var(--encre); }
  .logo--clair { color: #fff; }
  .logo__nom { font-family: var(--serif); font-size: 2.3rem; letter-spacing: -0.01em; }
  .logo__sous { margin-top: 0.15rem; font-family: var(--titre); font-size: 0.58rem; font-weight: 600; letter-spacing: 0.28em; text-transform: uppercase; }
  @media (max-width: 700px) { .logo__nom { font-size: 1.8rem; } }
</style>
