---
interface Props { taille?: 'petit' | 'grand' }
const { taille = 'petit' } = Astro.props;
---
<span class={`logo logo--${taille}`} aria-label="Woman"><span aria-hidden="true">woman</span></span>

<style>
  /* Pastille rose, comme l'avatar Instagram de la boutique */
  .logo {
    display: inline-grid; place-items: center; border-radius: 50%;
    background: var(--rose-vif); color: #fff;
    font-family: var(--serif); font-weight: 600; letter-spacing: 0.01em; line-height: 1;
    text-shadow: 0 1px 2px rgb(94 15 34 / 0.35);
  }
  .logo--petit { width: 64px; height: 64px; font-size: 1.05rem; }
  @media (max-width: 860px) { .logo--petit { width: 52px; height: 52px; font-size: 0.88rem; } }
  .logo--grand { width: 160px; height: 160px; font-size: 2.6rem; }
</style>
