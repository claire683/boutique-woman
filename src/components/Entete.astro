---
import Logo from './Logo.astro';
import { lien, boutique } from '../data/site';
const liens = [
  { href: lien('/#bonjour'), texte: 'Bonjour Woman' },
  { href: lien('/#collections'), texte: 'Collections' },
  { href: lien('/#histoire'), texte: 'La boutique' },
  { href: lien('/#venir'), texte: 'Venir' },
];
---
<header class="entete">
  <div class="wrap entete__barre">
    <a href={lien('/')} class="entete__logo" aria-label="Woman, retour à l'accueil"><Logo /></a>
    <nav aria-label="Navigation principale">
      <ul class="entete__menu">
        {liens.map((l) => <li><a href={l.href}>{l.texte}</a></li>)}
      </ul>
    </nav>
    <a class="entete__tel" href={boutique.telephoneLien}>{boutique.telephone}</a>
  </div>
</header>

<style>
  .entete {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--creme) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid color-mix(in srgb, var(--encre) 10%, transparent);
  }
  .entete__barre { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; height: 76px; }
  .entete__logo { text-decoration: none; }
  .entete__menu { display: flex; gap: 2rem; list-style: none; margin: 0; padding: 0; }
  .entete__menu a, .entete__tel {
    font-size: 0.78rem; letter-spacing: 0.18em; text-transform: uppercase; text-decoration: none;
  }
  .entete__menu a:hover { color: var(--fuchsia); }
  .entete__tel { font-weight: 500; padding: 0.55em 1.1em; border-radius: 999px; background: var(--fuchsia); color: #fff; }
  .entete__tel:hover { background: var(--bordeaux); }
  @media (max-width: 860px) {
    .entete__barre { flex-wrap: wrap; height: auto; padding-block: 0.7rem; row-gap: 0.4rem; }
    nav { order: 3; width: 100%; overflow-x: auto; scrollbar-width: none; }
    nav::-webkit-scrollbar { display: none; }
    .entete__menu { gap: 1.4rem; white-space: nowrap; padding-bottom: 0.2rem; }
  }
</style>
