---
// Ouverture animée : les pièces flottent, puis viennent se suspendre sur le portant
// au fil du défilement. Illustration vectorielle (pas de photo de produit).
import { lien, boutique } from '../data/site';
---
<section class="hp" id="ouverture" aria-label="Woman, boutique Liu Jo à Belfort">
  <div class="hp__scene">
    <div class="hp__textes">
      <div class="hp__texte" data-pas="0">
        <p class="hp__sur"><span>01 / 03</span> Les pièces</p>
        <h1>Un manteau, une maille, une robe.</h1>
        <p class="hp__chapo">Les nouveautés Liu&nbsp;Jo arrivent chaque semaine au 36, Faubourg des Ancêtres.</p>
      </div>
      <div class="hp__texte" data-pas="1">
        <p class="hp__sur"><span>02 / 03</span> Le portant</p>
        <p class="hp__titre">Natacha compose avec vous.</p>
        <p class="hp__chapo">Elle choisit, ajuste, et vous propose la pièce que vous n'auriez pas osé essayer.</p>
      </div>
      <div class="hp__texte" data-pas="2">
        <p class="hp__sur"><span>03 / 03</span> Votre essayage</p>
        <p class="hp__titre">Tout est prêt quand vous arrivez.</p>
        <p class="hp__chapo">Dites-nous ce que vous cherchez et quand vous passez : votre cabine vous attend.</p>
        <div class="hp__actions">
          <a class="hp__btn hp__btn--plein" href={lien('/#essayage')}>Préparer mon essayage</a>
          <a class="hp__btn" href={boutique.instagram} target="_blank" rel="noopener">Voir les nouveautés</a>
        </div>
      </div>
    </div>

    <svg class="hp__svg" viewBox="0 0 800 680" role="img" aria-label="Illustration : des vêtements viennent se suspendre sur un portant">
      <defs>
        <pattern id="hp-maille" width="12" height="12" patternUnits="userSpaceOnUse">
          <rect width="12" height="12" fill="#efe6d8" />
          <path d="M0 6 L3 0 L6 6 L9 0 L12 6 M0 12 L3 6 L6 12 L9 6 L12 12" fill="none" stroke="#dccfbd" stroke-width="1.2" />
        </pattern>
        <linearGradient id="hp-ombre" x1="0" x2="1">
          <stop offset="0" stop-color="#000" stop-opacity="0.18" />
          <stop offset="0.25" stop-color="#000" stop-opacity="0" />
          <stop offset="0.8" stop-color="#000" stop-opacity="0" />
          <stop offset="1" stop-color="#000" stop-opacity="0.16" />
        </linearGradient>
        <g id="hp-cintre">
          <path d="M0 -6 q0 -12 10 -12 q10 0 8 10 q-2 6 -18 14" fill="none" stroke="#2b2b2b" stroke-width="3" stroke-linecap="round" />
          <path d="M-52 30 L0 6 L52 30" fill="none" stroke="#b08a5e" stroke-width="5" stroke-linecap="round" />
        </g>
      </defs>

      <!-- Le portant -->
      <g class="hp__portant">
        <ellipse cx="400" cy="660" rx="330" ry="10" fill="#000" opacity="0.06" />
        <rect x="104" y="96" width="592" height="8" rx="4" fill="#1a1a1a" />
        <rect x="116" y="100" width="6" height="550" fill="#1a1a1a" />
        <rect x="678" y="100" width="6" height="550" fill="#1a1a1a" />
        <rect x="80" y="646" width="80" height="6" rx="3" fill="#1a1a1a" />
        <rect x="640" y="646" width="80" height="6" rx="3" fill="#1a1a1a" />
      </g>

      <!-- Manteau long -->
      <g class="hp__vet" data-ex="235" data-ey="118" data-sx="200" data-sy="150" data-sr="-9" data-ss="0.9">
        <use href="#hp-cintre" />
        <path d="M-50 30 L-72 66 L-80 232 L-62 236 L-56 120 Z M50 30 L72 66 L80 232 L62 236 L56 120 Z" fill="#a87a4c" />
        <path d="M-52 30 L-16 20 L0 86 L16 20 L52 30 L64 122 L60 318 L-60 318 L-64 122 Z" fill="#b98b5b" />
        <path d="M-52 30 L-16 20 L0 86 L16 20 L52 30 L64 122 L60 318 L-60 318 L-64 122 Z" fill="url(#hp-ombre)" />
        <path d="M-16 20 L-26 70 L0 86 Z M16 20 L26 70 L0 86 Z" fill="#9c6f42" />
        <path d="M2 86 L4 318" stroke="#8d6238" stroke-width="2" />
        <rect x="-62" y="160" width="124" height="12" fill="#9c6f42" />
        <circle cx="-8" cy="120" r="3.5" fill="#5a3d22" /><circle cx="-8" cy="210" r="3.5" fill="#5a3d22" />
      </g>

      <!-- Pull en maille -->
      <g class="hp__vet" data-ex="352" data-ey="118" data-sx="455" data-sy="70" data-sr="7" data-ss="0.85">
        <use href="#hp-cintre" />
        <path d="M-46 30 L-74 70 L-84 190 L-66 194 L-56 96 Z M46 30 L74 70 L84 190 L66 194 L56 96 Z" fill="url(#hp-maille)" stroke="#dccfbd" />
        <path d="M-48 30 Q-22 20 -14 22 Q0 40 14 22 Q22 20 48 30 L58 96 L56 196 L-56 196 L-58 96 Z" fill="url(#hp-maille)" stroke="#dccfbd" />
        <rect x="-56" y="182" width="112" height="16" fill="#e6dccb" />
        <path d="M-14 22 Q0 40 14 22" fill="none" stroke="#d3c4ae" stroke-width="5" />
      </g>

      <!-- Pantalon large -->
      <g class="hp__vet" data-ex="470" data-ey="118" data-sx="640" data-sy="190" data-sr="5" data-ss="0.85">
        <use href="#hp-cintre" />
        <rect x="-50" y="26" width="100" height="6" fill="#2b2b2b" />
        <path d="M-42 34 L42 34 L58 330 L12 330 L0 120 L-12 330 L-58 330 Z" fill="#1d1d1d" />
        <path d="M-42 34 L42 34 L58 330 L12 330 L0 120 L-12 330 L-58 330 Z" fill="url(#hp-ombre)" />
        <path d="M-24 40 L-34 326 M24 40 L34 326" stroke="#333" stroke-width="2" />
        <rect x="-42" y="34" width="84" height="14" fill="#2a2a2a" />
      </g>

      <!-- Robe -->
      <g class="hp__vet" data-ex="590" data-ey="118" data-sx="330" data-sy="300" data-sr="-6" data-ss="0.85">
        <use href="#hp-cintre" />
        <path d="M-22 26 L-18 60 M22 26 L18 60" stroke="#a10f62" stroke-width="5" />
        <path d="M-26 58 Q0 74 26 58 L34 124 L78 300 Q0 318 -78 300 L-34 124 Z" fill="#c8137a" />
        <path d="M-26 58 Q0 74 26 58 L34 124 L78 300 Q0 318 -78 300 L-34 124 Z" fill="url(#hp-ombre)" />
        <path d="M-34 124 Q0 132 34 124" fill="none" stroke="#a10f62" stroke-width="4" />
      </g>

      <!-- Sac -->
      <g class="hp__vet" data-ex="652" data-ey="112" data-sx="560" data-sy="430" data-sr="-12" data-ss="0.9">
        <path d="M0 -10 L0 30" stroke="#2b2b2b" stroke-width="3" />
        <path d="M-26 70 Q-26 30 0 30 Q26 30 26 70" fill="none" stroke="#5e0f22" stroke-width="6" />
        <rect x="-38" y="66" width="76" height="62" rx="6" fill="#6b1526" />
        <rect x="-38" y="66" width="76" height="20" rx="6" fill="#5e0f22" />
        <rect x="-8" y="80" width="16" height="9" rx="2" fill="#d6b25e" />
      </g>

      <!-- Bottines -->
      <g class="hp__vet" data-ex="200" data-ey="576" data-sx="250" data-sy="500" data-sr="8" data-ss="0.9">
        <path d="M-40 0 L-40 56 L-6 64 L-4 70 L-46 70 L-50 0 Z" fill="#161616" />
        <path d="M6 0 L6 56 L40 64 L42 70 L0 70 L-4 0 Z" fill="#232323" />
        <rect x="-50" y="68" width="48" height="4" fill="#000" />
        <rect x="-4" y="68" width="48" height="4" fill="#000" />
      </g>

      <!-- Étiquette finale -->
      <g class="hp__etiquette">
        <path d="M235 260 L235 300" stroke="#1a1a1a" stroke-width="1.5" />
        <g transform="translate(160 300) rotate(-6)">
          <rect width="150" height="64" rx="4" fill="#fff" stroke="#1a1a1a" stroke-width="1.5" />
          <circle cx="75" cy="10" r="4" fill="none" stroke="#1a1a1a" stroke-width="1.5" />
          <text x="75" y="36" text-anchor="middle" font-family="Bodoni Moda, Georgia, serif" font-style="italic" font-size="17" fill="#1a1a1a">Mis de côté</text>
          <text x="75" y="54" text-anchor="middle" font-family="Red Hat Display Variable, Arial, sans-serif" font-weight="700" font-size="10" letter-spacing="1.5" fill="#c8137a">POUR VOUS</text>
        </g>
      </g>
    </svg>

    <ol class="hp__points" aria-hidden="true"><li></li><li></li><li></li></ol>
    <p class="hp__defiler" aria-hidden="true">Faites défiler</p>
    <a class="hp__passer" href={lien('/#vestiaire')}>Passer l'intro ↓</a>
    <p class="hp__mention">Illustration</p>
  </div>
</section>

<script is:inline>
  (function () {
    var sec = document.getElementById('ouverture');
    if (!sec) return;
    var vets = Array.prototype.slice.call(sec.querySelectorAll('.hp__vet'));
    var textes = Array.prototype.slice.call(sec.querySelectorAll('.hp__texte'));
    var points = Array.prototype.slice.call(sec.querySelectorAll('.hp__points li'));
    var etiquette = sec.querySelector('.hp__etiquette');
    var reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var lisse = function (t) { return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; };
    var borne = function (v) { return Math.max(0, Math.min(1, v)); };
    var visible = true;
    var dernier = -1;

    function progression() {
      if (reduit) return 1;
      var r = sec.getBoundingClientRect();
      var course = sec.offsetHeight - window.innerHeight;
      return course > 0 ? borne(-r.top / course) : 1;
    }

    function rendre(temps) {
      var p = progression();
      vets.forEach(function (g, i) {
        var d = g.dataset;
        var e = lisse(borne((p - 0.18 - i * 0.06) / 0.34));
        var flotte = reduit ? 0 : (1 - e) * Math.sin(temps / 900 + i * 1.7) * 7;
        var x = +d.sx + (+d.ex - +d.sx) * e;
        var y = +d.sy + (+d.ey - +d.sy) * e + flotte;
        var rot = +d.sr * (1 - e) + (reduit ? 0 : (1 - e) * Math.sin(temps / 1300 + i) * 2);
        var s = +d.ss + (1 - +d.ss) * e;
        g.setAttribute('transform', 'translate(' + x.toFixed(1) + ' ' + y.toFixed(1) + ') rotate(' + rot.toFixed(2) + ') scale(' + s.toFixed(3) + ')');
      });
      var pas = p < 0.3 ? 0 : p < 0.72 ? 1 : 2;
      if (pas !== dernier) {
        textes.forEach(function (t, i) { t.classList.toggle('actif', i === pas); t.setAttribute('aria-hidden', i === pas ? 'false' : 'true'); });
        points.forEach(function (pt, i) { pt.classList.toggle('actif', i === pas); });
        dernier = pas;
      }
      etiquette.style.opacity = String(borne((p - 0.74) / 0.12));
      sec.classList.toggle('hp--defile', p > 0.04);
      if (visible && !reduit) requestAnimationFrame(rendre);
    }

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entrees) {
        var etait = visible;
        visible = entrees[0].isIntersecting;
        if (visible && !etait) requestAnimationFrame(rendre);
      }).observe(sec);
    }
    if (reduit) sec.classList.add('hp--fixe');
    requestAnimationFrame(rendre);
  })();
</script>

<style>
  .hp { position: relative; height: 320vh; background: #f5f1ec; }
  .hp__scene {
    position: sticky; top: 0; height: 100svh; overflow: hidden;
    display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); align-items: center;
    gap: clamp(1rem, 4vw, 4rem); padding: 5rem clamp(1.25rem, 5vw, 5rem) 3rem;
  }
  .hp__textes { position: relative; min-height: 22rem; }
  .hp__texte { position: absolute; inset: 0 0 auto 0; opacity: 0; transform: translateY(18px); transition: opacity 0.5s ease, transform 0.5s ease; pointer-events: none; }
  .hp__texte.actif { opacity: 1; transform: none; pointer-events: auto; }
  .hp__sur { margin: 0 0 1rem; font-family: var(--titre); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fuchsia); }
  .hp__sur span { color: var(--gris); margin-right: 0.8rem; font-weight: 500; }
  .hp h1, .hp__titre {
    margin: 0; font-family: var(--titre); font-weight: 700; text-transform: uppercase; letter-spacing: 0.005em;
    font-size: clamp(2.2rem, 4.6vw, 4.4rem); line-height: 0.98; color: var(--encre);
  }
  .hp__chapo { margin: 1.4rem 0 0; max-width: 30rem; font-size: 1.15rem; line-height: 1.55; }
  .hp__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.8rem; }
  .hp__btn {
    display: inline-block; padding: 0.85rem 1.5rem; border: 1px solid var(--encre); color: var(--encre); text-decoration: none;
    font-family: var(--titre); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .hp__btn:hover, .hp__btn--plein { background: var(--encre); color: #fff; }
  .hp__btn--plein:hover { background: var(--fuchsia); border-color: var(--fuchsia); }
  .hp__svg { width: 100%; height: auto; max-height: calc(100svh - 7rem); }
  .hp__etiquette { opacity: 0; transition: opacity 0.2s; }
  .hp__points { position: absolute; right: clamp(0.8rem, 2vw, 1.6rem); top: 50%; translate: 0 -50%; list-style: none; margin: 0; padding: 0; display: grid; gap: 0.8rem; }
  .hp__points li { width: 9px; height: 9px; border-radius: 50%; border: 1.5px solid var(--encre); transition: background 0.3s; }
  .hp__points li.actif { background: var(--encre); }
  .hp__defiler {
    position: absolute; left: 50%; bottom: 1.2rem; translate: -50% 0; margin: 0;
    font-family: var(--titre); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gris);
    transition: opacity 0.4s;
  }
  .hp--defile .hp__defiler { opacity: 0; }
  .hp__passer {
    position: absolute; left: clamp(1.25rem, 5vw, 5rem); bottom: 1.2rem; padding: 0.55rem 1rem; background: #fff; border-radius: 999px;
    font-size: 0.85rem; font-weight: 500; text-decoration: none; box-shadow: 0 4px 14px rgb(0 0 0 / 0.08);
  }
  .hp__mention { position: absolute; right: clamp(1.25rem, 5vw, 5rem); bottom: 1.2rem; margin: 0; font-size: 0.75rem; font-style: italic; color: var(--gris); }

  /* Animations réduites : tout est affiché, sans défilement imposé */
  .hp--fixe { height: auto; }
  .hp--fixe .hp__scene { position: relative; height: auto; min-height: 80svh; }
  .hp--fixe .hp__texte { position: relative; display: none; }
  .hp--fixe .hp__texte[data-pas="2"] { display: block; opacity: 1; transform: none; }
  .hp--fixe .hp__defiler, .hp--fixe .hp__points, .hp--fixe .hp__passer { display: none; }
  .hp--fixe .hp__etiquette { opacity: 1 !important; }

  @media (max-width: 800px) {
    .hp { height: 280vh; }
    .hp__scene { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr; align-items: start; padding: 7rem 1.25rem 3.5rem; gap: 0.5rem; }
    .hp__textes { min-height: 15rem; }
    .hp h1, .hp__titre { font-size: clamp(1.9rem, 8vw, 2.6rem); }
    .hp__chapo { font-size: 1rem; margin-top: 0.9rem; }
    .hp__actions { margin-top: 1.1rem; }
    .hp__svg { max-height: 46svh; align-self: center; }
    .hp__points { display: none; }
    .hp__mention { display: none; }
  }
</style>
